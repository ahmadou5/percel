{
  "expo": {
    "name": "Percel",
    "slug": "percel-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios-1024.png",
    "scheme": "percel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "icon": "./assets/icon-ios-1024.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.percel.user",
      "config": {
        "googleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
      }
    },
    "android": {
      "package": "com.percel.user",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#0F172A",
        "monochromeImage": "./assets/icon-android-foreground.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCodePush.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/notification-icon.png",
          "color": "#0A84FF"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik",
          "iosGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      ],
      [
        "expo-alternate-app-icons",
        {
          "icons": [
            {
              "name": "icon-teal",
              "ios": { "images": ["./assets/images/icons/icon-teal.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-teal.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-teal.png"
              }
            },
            {
              "name": "icon-sky",
              "ios": { "images": ["./assets/images/icons/icon-sky.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-sky.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-sky.png"
              }
            },
            {
              "name": "icon-indigo",
              "ios": { "images": ["./assets/images/icons/icon-indigo.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-indigo.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-indigo.png"
              }
            },
            {
              "name": "icon-amber",
              "ios": { "images": ["./assets/images/icons/icon-amber.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-amber.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-amber.png"
              }
            },
            {
              "name": "icon-red",
              "ios": { "images": ["./assets/images/icons/icon-red.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-red.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-red.png"
              }
            },
            {
              "name": "icon-green",
              "ios": { "images": ["./assets/images/icons/icon-green.png"] },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-green.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-green.png"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6074075d-15bb-44aa-b777-6bef939bb79a"
      }
    },
    "owner": "ahmadousol"
  }
}