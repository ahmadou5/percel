{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.18.1",
      "channel": "base"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://percelapi-production-4ab1.up.railway.app",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://percelapi-production-4ab1.up.railway.app",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://percelapi-production-4ab1.up.railway.app",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "TODO_APPLE_ID",
        "ascAppId": "TODO_ASC_APP_ID",
        "appleTeamId": "TODO_APPLE_TEAM_ID"
      }
    }
  }
}