{
  "expo": {
    "name": "Percel Driver",
    "slug": "percel-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "percel-driver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.percel.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Percel uses your location to match deliveries near you and keep customers updated.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Percel uses your location in the background to keep trip tracking active while you are online.",
        "NSCameraUsageDescription": "Percel uses your camera to capture KYC documents and delivery verification photos.",
        "NSPhotoLibraryUsageDescription": "Percel uses your photo library when you choose existing KYC documents or delivery photos.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.percel.driver",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0EA5E9"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik",
          "iosGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      ],
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8e8b69d-24b1-471c-bf1a-7f0a52fa045a"
      }
    },
    "owner": "ahmadousol"
  }
}