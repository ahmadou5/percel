{
  "expo": {
    "name": "Percel Driver",
    "slug": "percel-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios-1024.png",
    "scheme": "percel-driver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "icon": "./assets/icon-ios-1024.png",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.percel.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Percel uses your location to match deliveries near you and keep customers updated.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Percel uses your location in the background to keep trip tracking active while you are online.",
        "NSCameraUsageDescription": "Percel uses your camera to capture KYC documents and delivery verification photos.",
        "NSPhotoLibraryUsageDescription": "Percel uses your photo library when you choose existing KYC documents or delivery photos.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#0F172A",
        "monochromeImage": "./assets/icon-android-foreground.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.percel.driver",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0EA5E9"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik",
          "iosGoogleMapsApiKey": "AIzaSyDnMvVmGdj8xI_LrOEJ447dTeLX-KDywik"
        }
      ],
      [
        "expo-alternate-app-icons",
        {
          "icons": [
            {
              "name": "icon-teal",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-teal.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-teal.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-teal.png"
              }
            },
            {
              "name": "icon-sky",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-sky.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-sky.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-sky.png"
              }
            },
            {
              "name": "icon-indigo",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-indigo.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-indigo.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-indigo.png"
              }
            },
            {
              "name": "icon-amber",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-amber.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-amber.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-amber.png"
              }
            },
            {
              "name": "icon-red",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-red.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-red.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-red.png"
              }
            },
            {
              "name": "icon-green",
              "ios": {
                "images": [
                  "./assets/images/icons/icon-green.png"
                ]
              },
              "android": {
                "foregroundImage": "./assets/images/icons/android/android-icon-green.png",
                "backgroundColor": "#0F172A",
                "monochromeImage": "./assets/images/icons/android/android-icon-green.png"
              }
            }
          ]
        }
      ],
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
