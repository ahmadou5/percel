generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), postgis]
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DriverStatus {
  PENDING_KYC
  KYC_SUBMITTED
  ACTIVE
  SUSPENDED
  OFFLINE
  ONLINE
}

enum VehicleType {
  BIKE
  CAR
  VAN
  TRUCK
}

enum DriverKYCStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  PENDING_MATCH
  MATCHED
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OrderSize {
  SMALL
  MEDIUM
  LARGE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletTransactionCategory {
  TOP_UP
  ORDER_PAYMENT
  ORDER_EARNING
  TRANSFER_IN
  TRANSFER_OUT
  AIRTIME
  DATA
  ELECTRICITY
  TV
  COMMISSION
  REFUND
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT
  SYSTEM
  PROMO
}

enum DriverEarningStatus {
  PENDING
  SETTLED
}

model User {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String     @unique
  phone         String     @unique
  passwordHash  String
  walletPinHash String?
  fullName      String
  avatarUrl     String?
  dateOfBirth   DateTime?
  address       String?
  ninNumber     String?
  ninVerified   Boolean    @default(false)
  bvnNumber     String?
  bvnVerified   Boolean    @default(false)
  deletedAt     DateTime?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  refreshToken  String?
  expoPushToken String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet        Wallet?
  orders        Order[]
  notifications Notification[]
  driver        Driver?
  orderRatings  OrderRating[]
}

model Driver {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String       @unique @db.Uuid
  licenseNumber   String       @unique
  vehicleType     VehicleType
  vehiclePlate    String
  vehicleModel    String
  status          DriverStatus @default(PENDING_KYC)
  rating          Decimal      @default(5.0) @db.Decimal(3, 2)
  totalDeliveries Int          @default(0)
  isOnline        Boolean      @default(false)
  currentLat      Decimal?     @db.Decimal(10, 7)
  currentLng      Decimal?     @db.Decimal(10, 7)
  lastLocationAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  kyc      DriverKYC?
  orders   Order[]
  earnings DriverEarning[]
  ratings  OrderRating[]

  @@index([isOnline])
  @@index([status])
  @@index([currentLat, currentLng])
}

model DriverKYC {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId        String          @unique @db.Uuid
  ninNumber       String
  ninVerified     Boolean         @default(false)
  bvnNumber       String
  bvnVerified     Boolean         @default(false)
  licenseImageUrl String?
  selfieUrl       String?
  vehicleImageUrl String?
  smileJobId      String?
  status          DriverKYCStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])
}

model Order {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackingCode String      @unique
  userId       String      @db.Uuid
  driverId     String?     @db.Uuid
  status       OrderStatus @default(CREATED)
  size         OrderSize

  pickupStreet           String
  pickupCity             String
  pickupState            String
  pickupCountry          String
  pickupLat              Decimal @db.Decimal(10, 7)
  pickupLng              Decimal @db.Decimal(10, 7)
  pickupPlaceId          String
  pickupFormattedAddress String

  deliveryStreet           String
  deliveryCity             String
  deliveryState            String
  deliveryCountry          String
  deliveryLat              Decimal @db.Decimal(10, 7)
  deliveryLng              Decimal @db.Decimal(10, 7)
  deliveryPlaceId          String
  deliveryFormattedAddress String

  distanceKm           Decimal       @db.Decimal(10, 2)
  estimatedDurationMin Int
  price                Decimal       @db.Decimal(12, 2)
  currency             String        @default("NGN")
  notes                String?
  fragile              Boolean       @default(false)
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  cancelReason         String?
  disputeReason        String?
  paymentReference     String?
  paymentStatus        PaymentStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  driver        Driver?              @relation(fields: [driverId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  rating        OrderRating?
  transactions  WalletTransaction[]
  earnings      DriverEarning[]

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([trackingCode])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId     String  @db.Uuid
  description String
  quantity    Int
  weightKg    Decimal @db.Decimal(10, 2)
  fragile     Boolean @default(false)
  imageUrl    String?

  order Order @relation(fields: [orderId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  lat       Decimal?    @db.Decimal(10, 7)
  lng       Decimal?    @db.Decimal(10, 7)
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Wallet {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String   @unique @db.Uuid
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  ledgerBalance Decimal  @default(0) @db.Decimal(14, 2)
  currency      String   @default("NGN")
  nuban         String?  @unique
  bankName      String?
  bankCode      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  transactions  WalletTransaction[]
  debitEntries  LedgerEntry[]       @relation("DebitWallet")
  creditEntries LedgerEntry[]       @relation("CreditWallet")
}

model WalletTransaction {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId          String                    @db.Uuid
  amount            Decimal                   @db.Decimal(14, 2)
  type              WalletTransactionType
  category          WalletTransactionCategory
  status            WalletTransactionStatus   @default(PENDING)
  reference         String                    @unique
  paystackReference String?
  description       String
  metadata          Json                      @default("{}")
  balanceBefore     Decimal                   @db.Decimal(14, 2)
  balanceAfter      Decimal                   @db.Decimal(14, 2)
  orderId           String?                   @db.Uuid
  createdAt         DateTime                  @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([reference])
}

model LedgerEntry {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  debitWalletId  String   @db.Uuid
  creditWalletId String   @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  reference      String   @unique
  description    String
  createdAt      DateTime @default(now())

  debitWallet  Wallet @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet Wallet @relation("CreditWallet", fields: [creditWalletId], references: [id])
}

model OrderRating {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId       String   @unique @db.Uuid
  userId        String   @db.Uuid
  driverId      String   @db.Uuid
  userRating    Int
  userComment   String?
  driverRating  Int?
  driverComment String?
  createdAt     DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model DriverEarning {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId         String              @db.Uuid
  orderId          String              @db.Uuid
  grossAmount      Decimal             @db.Decimal(14, 2)
  commissionAmount Decimal             @db.Decimal(14, 2)
  netAmount        Decimal             @db.Decimal(14, 2)
  status           DriverEarningStatus @default(PENDING)
  settledAt        DateTime?
  createdAt        DateTime            @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
}
