    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-native": "^5.0.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/fastify": "^7.1.5",
